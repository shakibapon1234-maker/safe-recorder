{
  "name": "safe-recorder",
  "version": "1.0.0",
  "description": "Screen recorder with one-key blur boxes",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "dependencies": {
    "electron": "^42.11.0",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.wfa.saferecorder",
    "productName": "Safe Recorder",
    "files": [
      "**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": "portable"
    }
  }
}
